<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.WarehouseScanner" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <item name="android:windowBackground">@drawable/ws_bg_radial</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <item name="colorPrimary">@color/ws_accent</item>
        <item name="colorPrimaryVariant">@color/ws_accent2</item>
        <item name="colorSecondary">@color/ws_accent2</item>
        <item name="colorError">@color/ws_danger</item>

        <item name="android:colorBackground">@color/ws_bg</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
        <item name="android:textColorPrimary">@color/ws_text</item>
        <item name="android:textColorSecondary">@color/ws_muted</item>

        <item name="materialCardViewStyle">@style/WS.Card</item>
        <item name="textInputStyle">@style/WS.TextInputLayout</item>
        <item name="materialButtonStyle">@style/WS.Button.Ghost</item>
    </style>

    <style name="Theme.WarehouseScanner" parent="Base.Theme.WarehouseScanner" />

    <!-- щоб не падало, якщо десь лишилось style="@style/WS" -->
    <style name="WS" />

    <!-- ===== Components ===== -->

    <style name="WS.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/ws_overlay_03</item>
        <item name="strokeColor">@color/ws_stroke_strong</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">18dp</item>
    </style>

    <style name="WS.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">#16000000</item>

        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>

        <item name="boxStrokeColor">@color/ws_stroke_strong</item>
        <item name="boxStrokeErrorColor">@color/ws_danger</item>

        <item name="hintTextColor">@color/ws_muted</item>
        <item name="android:textColorHint">@color/ws_muted</item>
    </style>

    <style name="WS.Button.Base" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textStyle">bold</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="WS.Button.Ghost" parent="WS.Button.Base">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:background">@drawable/ws_btn_ghost_bg</item>
        <item name="android:textColor">@color/ws_text</item>
    </style>

    <style name="WS.Button.Primary" parent="WS.Button.Base">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:background">@drawable/ws_btn_primary_bg</item>
        <item name="android:textColor">#081018</item>
    </style>

    <style name="WS.Button.Danger" parent="WS.Button.Base">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:background">@drawable/ws_btn_danger_bg</item>
        <item name="android:textColor">@color/ws_text</item>
    </style>

    <!-- НОВЕ: плиткова кнопка (максимально близько до "tile" у макеті) -->
    <style name="WS.Button.Tile" parent="WS.Button.Base">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:background">@drawable/ws_btn_tile_bg</item>
        <item name="android:textColor">@color/ws_text</item>
        <item name="android:elevation">2dp</item>
    </style>

    <style name="WS.Title">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ws_text</item>
    </style>

    <style name="WS.Subtitle">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/ws_muted</item>
    </style>

    <style name="WS.Label">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/ws_muted</item>
    </style>

</resources>
