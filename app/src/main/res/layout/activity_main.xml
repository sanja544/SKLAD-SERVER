<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="18dp">

    <TextView
        android:id="@+id/tvSyncStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:text="Offline"
        android:textSize="12sp"
        android:textColor="@color/ws_text"
        android:maxLines="1"
        android:ellipsize="end"
        android:background="@drawable/ws_status_pill_bg"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Якір для плиток (порожній, щоб не ламати constraints) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardStatus"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        app:layout_constraintTop_toBottomOf="@id/tvSyncStatus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:cardCornerRadius="20dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/ws_stroke_strong"
        app:cardBackgroundColor="@android:color/transparent" />

    <Button
        android:id="@+id/btnInventory"
        style="@style/WS.Button.Tile"
        android:layout_width="0dp"
        android:layout_height="96dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="8dp"
        android:gravity="start|center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="📦  Склад&#10;пошук, фото, редагування"
        android:textSize="14sp"
        android:lineSpacingExtra="2dp"
        app:layout_constraintTop_toBottomOf="@id/cardStatus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnIssue" />

    <Button
        android:id="@+id/btnIssue"
        style="@style/WS.Button.Tile"
        android:layout_width="0dp"
        android:layout_height="96dp"
        android:layout_marginTop="14dp"
        android:layout_marginStart="8dp"
        android:gravity="start|center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="➖  Видача&#10;скануй → введи → списати"
        android:textSize="14sp"
        android:lineSpacingExtra="2dp"
        app:layout_constraintTop_toBottomOf="@id/cardStatus"
        app:layout_constraintStart_toEndOf="@id/btnInventory"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnAddProduct"
        style="@style/WS.Button.Primary"
        android:layout_width="0dp"
        android:layout_height="96dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="8dp"
        android:gravity="start|center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="➕  Додати товар&#10;штрихкод, ціна, кількість"
        android:textSize="14sp"
        android:lineSpacingExtra="2dp"
        app:layout_constraintTop_toBottomOf="@id/btnInventory"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnSync" />

    <Button
        android:id="@+id/btnSync"
        style="@style/WS.Button.Tile"
        android:layout_width="0dp"
        android:layout_height="96dp"
        android:layout_marginTop="10dp"
        android:layout_marginStart="8dp"
        android:gravity="start|center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="⚙️  Синхронізація&#10;налаштування IP / Pull / Push"
        android:textSize="14sp"
        android:lineSpacingExtra="2dp"
        app:layout_constraintTop_toBottomOf="@id/btnIssue"
        app:layout_constraintStart_toEndOf="@id/btnAddProduct"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
